# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used for local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files
.terraform.lock.hcl

# Ignore IDE specific files
.idea/
.vscode/
*.swp
*.swo

# Ignore local environment files
.env
.env.*
!.env.example

# Ignore terraform cache
.terraform/

# Ignore terraform plan output
*.tfplan

# Ignore terraform override files
*_override.tf
*_override.tf.json

# Ignore terraform lock file
.terraform.lock.hcl

# Ignore terraform state files
*.tfstate
*.tfstate.*

# Ignore terraform crash log
crash.log

# Ignore terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore terraform variables files except the example
*.tfvars
!terraform.tfvars.example

# Ignore terraform plan output
*.tfplan
